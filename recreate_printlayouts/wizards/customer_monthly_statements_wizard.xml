<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_customer_monthly_statement" model="ir.ui.view">
        <field name="name">account.customer.monthly.statement.wizard.form</field>
        <field name="model">account.customer.monthly.statements</field>
        <field name="arch" type="xml">
            <form string="Customer Monthly Statement">
                <group>
                    <field name="partner_id"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                </group>
                <footer>
                    <button name="action_button" string="Confirm" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x" />
                </footer>
            </form>
        </field>
    </record>

</odoo>