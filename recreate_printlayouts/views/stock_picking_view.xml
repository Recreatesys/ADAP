<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_picking_form_inherit" model="ir.ui.view">
            <field name="name">Stock Picking Form Inherit</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='other_infos']/field[@name='move_type']" position="after">
                    <field name="trade_terms"/>
                    <field name="shipping_marks"/>
                    <field name="port_of_loading"/>
                    <field name="port_of_discharge"/>
                    <field name="country_of_origin"/>
                    <field name="name_of_vessel"/>
                    <field name="voyage_number"/>
                    <field name="shipment_date"/>
                    <field name="bill_of_lading_number"/>
                </xpath>

                <xpath expr="//group[@name='other_infos']/field[@name='company_id']" position="after">
                    <field name="remarks"/>
                </xpath>

                <xpath expr="//div[@class='o_td_label']" position="before">
                    <field name="pl_number"/>
                    <field name="pi_number"/>
                    <field name="insurance_address"/>
                    <field name="bank_address"/>
                </xpath>

                <xpath expr="//field[@name='origin']" position="before">
                    <field name="container_number"/>
                    <field name="seal_number"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>