<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_move_form_inherit" model="ir.ui.view">
            <field name="name">Account Move Form Inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='invoice_user_id']" position="after">
                    <field name="remarks"/>
                </xpath>

                <xpath expr="//page[@name='other_info']" position="before">
                    <page string="Trade Terms" name="trade_terms">
                        <group>
                            <field name="total_value"/>
                            <field name="trade_term"/>
                            <field name="port_of_loading"/>
                            <field name="country_of_origin"/>
                            <field name="net_weight"/>
                            <field name="gross_weight"/>
                        </group>
                    </page>
                </xpath>

                <xpath expr="//field[@name='partner_shipping_id']" position="before">
                    <field name="pi_number"/>
                </xpath>

                <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='product_id']" position="after">
                    <field name="remarks"/>
                </xpath>

                <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='quantity']" position="after">
                    <field name="weight"/>
                </xpath>

                <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='price_unit']" position="after">
                    <field name="rate"/>
                </xpath>

            </field>
        </record>
    </data>
</odoo>