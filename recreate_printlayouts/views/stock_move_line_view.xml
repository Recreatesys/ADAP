<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_picking_form_inherit" model="ir.ui.view">
            <field name="name">Stock Move Line Inherit</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='move_ids_without_package']/list/field[@name='quantity']" position="before">
                    <field name="cartons"/>
                    <field name="net_weight"/>
                    <field name="gross_weight"/>
                </xpath>

                <xpath expr="//field[@name='move_ids_without_package']/list/field[@name='product_uom']" position="after">
                    <field name="net_weight"/>
                    <field name="gross_weight"/>
                </xpath>

            </field>
        </record>
    </data>
</odoo>