<odoo>

    <record id="action_adap_commercial_invoice" model="ir.actions.report">
        <field name="name">Adap Commercial Invoice</field>
        <field name="model">account.move</field>
        <field name="report_type">xlsx</field>
        <field name="report_name">recreate_printlayouts.report_adap_commercial_invoice</field>
        <field name="report_file">recreate_printlayouts.report_adap_commercial_invoice</field>
        <field name="print_report_name">'Commercial Invoice - ' + (object._get_report_base_filename())</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
    </record>

    <record id="action_adap_packing_list" model="ir.actions.report">
        <field name="name">Adap Packing List</field>
        <field name="model">stock.picking</field>
        <field name="report_type">xlsx</field>
        <field name="report_name">recreate_printlayouts.report_adap_packing_list</field>
        <field name="report_file">recreate_printlayouts.report_adap_packing_list</field>
        <field name="print_report_name">'Adap Packing List'</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
    </record>
</odoo>