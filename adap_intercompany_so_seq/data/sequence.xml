<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Dedicated sequence for company C-鼎盛電鍍 inter-company sale orders.
         number_next is aligned per-database (to max existing C number + 1)
         during the renumbering migration. -->
    <record id="seq_sale_order_c" model="ir.sequence">
        <field name="name">Sale Order (C-鼎盛電鍍)</field>
        <field name="code">adap.sale.order.c</field>
        <field name="prefix">C</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
