<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_order_form_inherit" model="ir.ui.view">
            <field name="name">Sale Order Form Inherit</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='client_order_ref']" position="attributes">
                    <attribute name="string">Client PO No.</attribute>
                </xpath>

                <xpath expr="//field[@name='payment_term_id']" position="after">
                    <field name="lc_number"/>
                    <field name="lc_issue_date"/>
                </xpath>

                <xpath expr="//label[@for='commitment_date']" position="before">
                    <field name="shipping_method"/>
                    <field name="loading_port"/>
                    <field name="country_of_origin"/>
                </xpath>

            </field>
        </record>

        <!-- Move Incoterm + Incoterm Location directly under Delivery Address.
             High priority so it runs after the views that add those fields. -->
        <record id="view_order_form_incoterm_under_delivery" model="ir.ui.view">
            <field name="name">sale.order.form.incoterm.under.delivery</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="priority">200</field>
            <field name="arch" type="xml">
                <!-- Show the STANDARD Incoterm + Incoterm Location directly under Delivery Address -->
                <xpath expr="//field[@name='partner_shipping_id']" position="after">
                    <xpath expr="//field[@name='incoterm']" position="move"/>
                    <xpath expr="//field[@name='incoterm_location']" position="move"/>
                </xpath>
                <!-- Hide the redundant custom Incoterm field (x_incoterm_custom_id, shows "Unnamed") -->
                <xpath expr="//field[@name='x_incoterm_custom_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>