        <record id="action_monthly_statement" model="ir.actions.act_window">
            <field name="name">Customer Monthly Statement</field>
            <field name="res_model">account.customer.monthly.statements</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_customer_monthly_statement"/>
            <field name="target">new</field> 
            <field name="context">{}</field>
        </record>

        <record id="action_inter_monthly_statement" model="ir.actions.act_window">
            <field name="name">ADAP Monthly Statement</field>
