            <field name="view_id" ref="view_adap_monthly_statement"/>
            <field name="target">new</field> 
            <field name="context">{}</field>
        </record>

        
        <menuitem id="customer_monthly_statement" 
                  name="Customer Monthly Statement"
                  parent="account.account_reports_partners_reports_menu"
                  action="action_monthly_statement"
                  sequence="51"/>
        
        <menuitem id="adap_inter_monthly_statement" 
                  name="ADAP Monthly Statement"
                  parent="account.account_reports_partners_reports_menu"
                  action="action_inter_monthly_statement"
                  sequence="51"/>
