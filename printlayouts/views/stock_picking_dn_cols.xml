<odoo>
    <record id="view_picking_form_dn_cols" model="ir.ui.view">
        <field name="name">stock.picking.form.dn.cols</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_ids_without_package']/list/field[@name='cartons']" position="attributes">
                <attribute name="string">箱数</attribute>
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='move_ids_without_package']/list/field[@name='product_uom']" position="after">
                <field name="x_dn_remark" string="备注" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
