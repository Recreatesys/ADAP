<odoo>

    <record id="action_adap_commercial_invoice" model="ir.actions.report">
        <field name="name">Adap Commercial Invoice</field>
        <field name="model">account.move</field>
        <field name="report_type">xlsx</field>
        <field name="report_name">printlayouts.report_adap_commercial_invoice</field>
        <field name="report_file">printlayouts.report_adap_commercial_invoice</field>
        <field name="print_report_name">'Commercial Invoice - ' + (object._get_report_base_filename())</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
    </record>

    <record id="action_adap_packing_list" model="ir.actions.report">
        <field name="name">Adap Packing List</field>
        <field name="model">stock.picking</field>
        <field name="report_type">xlsx</field>
        <field name="report_name">printlayouts.report_adap_packing_list</field>
        <field name="report_file">printlayouts.report_adap_packing_list</field>
        <field name="print_report_name">'Adap Packing List'</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
    </record>

    <record id="action_adap_beneficiary_cert" model="ir.actions.report">
        <field name="name">Adap Beneficiary Certificate</field>
        <field name="model">stock.picking</field>
        <field name="report_type">xlsx</field>
        <field name="report_name">printlayouts.report_adap_beneficiary_cert</field>
        <field name="report_file">printlayouts.report_adap_beneficiary_cert</field>
        <field name="print_report_name">'Adap Beneficiary Certificate'</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
    </record>

    <record id="action_adap_certificate" model="ir.actions.report">
        <field name="name">Adap Certificate</field>
        <field name="model">stock.picking</field>
        <field name="report_type">xlsx</field>
        <field name="report_name">printlayouts.report_adap_certificate</field>
        <field name="report_file">printlayouts.report_adap_certificate</field>
        <field name="print_report_name">'Adap Certificate'</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
    </record>

    <record id="action_adap_shipping_adivce" model="ir.actions.report">
        <field name="name">Adap Shipping Advice</field>
        <field name="model">stock.picking</field>
        <field name="report_type">xlsx</field>
        <field name="report_name">printlayouts.report_adap_shipping_advise</field>
        <field name="report_file">printlayouts.report_adap_shipping_advise</field>
        <field name="print_report_name">'Adap Shipping Advice'</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
    </record>

    <record id="action_adap_proforma_invoice" model="ir.actions.report">
        <field name="name">Adap Proforma Invoice</field>
        <field name="model">sale.order</field>
        <field name="report_type">xlsx</field>
        <field name="report_name">printlayouts.report_adap_proforma_invoice</field>
        <field name="report_file">printlayouts.report_adap_proforma_invoice</field>
        <field name="print_report_name">'Proforma Invoice - %s' % (object.name)</field>
        <!-- Unbound from the sale.order Print menu (button removed) — keep the
             action so the report can still be triggered programmatically. -->
        <field name="binding_model_id" eval="False"/>
    </record>

    <!-- Remove standard Sales Order Print buttons: "PDF Quote" and
         "Quotation / Order". Unbind (button removed) — reports still exist. -->
    <record id="sale.action_report_saleorder" model="ir.actions.report">
        <field name="binding_model_id" eval="False"/>
    </record>
    <record id="sale_pdf_quote_builder.action_report_saleorder_raw" model="ir.actions.report">
        <field name="binding_model_id" eval="False"/>
    </record>

    <record id="action_adap_monthly_statements" model="ir.actions.report">
        <field name="name">Adap Customer Monthly Statement</field>
        <field name="model">account.customer.monthly.statements</field>
        <field name="report_type">xlsx</field>
        <field name="report_name">printlayouts.report_adap_monthly_statements</field>
        <field name="report_file">printlayouts.report_adap_monthly_statements</field>
        <field name="print_report_name">(object._get_report_filename())</field>
        <field name="binding_model_id" ref="printlayouts.model_account_customer_monthly_statements"/>
    </record>


    <record id="action_adap_inter_statements" model="ir.actions.report">
        <field name="name">Adap Monthly Statement</field>
        <field name="model">adap.monthly.statement.wizard</field>
        <field name="report_type">xlsx</field>
        <field name="report_name">printlayouts.report_adap_inter_statements</field>
        <field name="report_file">printlayouts.report_adap_inter_statements</field>
        <field name="print_report_name">(object._get_report_filename())</field>
        <field name="binding_model_id" ref="printlayouts.model_adap_monthly_statement_wizard"/>
    </record>

    <record id="action_adap_account_receivable_report" model="ir.actions.report">
        <field name="name">ADAP Account Receivable</field>
        <field name="model">account.move</field>
        <field name="report_type">xlsx</field>
        <field name="report_name">printlayouts.report_adap_account_receivable_report</field>
        <field name="report_file">printlayouts.report_adap_account_receivable_report</field>
        <field name="print_report_name">'應收賬'</field>
    </record>
    
</odoo>