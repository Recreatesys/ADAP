<odoo>

    <!-- ============================================================
         Pro-Forma Invoice (sale.order) layout tweaks.

         The live "Pro-Forma Invoice" report (sale.report_saleorder_pro_forma)
         renders sale.report_saleorder_document, a Studio-customized primary
         view (id 1053) on this DB. This inherited view layers the requested
         changes on top of it.
         ============================================================ -->

    <record id="report_saleorder_document_adap_proforma" model="ir.ui.view">
        <field name="name">sale.report_saleorder_document.adap.proforma</field>
        <field name="inherit_id" ref="sale.report_saleorder_document"/>
        <field name="arch" type="xml">

            <!-- 1. Title wording: "Pro-Forma Invoice No.:" -> "Proforma Invoice No.:" -->
            <xpath expr="//h2/span[1]" position="replace">
                <span t-if="env.context.get('proforma', False) or is_pro_forma">Proforma Invoice No.: </span>
            </xpath>

            <!-- 2. Add "PO Number" (x_studio_client_po_reference), left of PI Expiry Date -->
            <xpath expr="//div[@name='expiration_date']" position="before">
                <div t-if="doc.x_studio_client_po_reference" class="col" name="po_number">
                    <strong>PO Number</strong>
                    <div t-field="doc.x_studio_client_po_reference"/>
                </div>
            </xpath>

            <!-- 3. Remove the "Inco-term:" (x_incoterm_custom_id) line from the totals area -->
            <xpath expr="//span[@t-if='doc.x_incoterm_custom_id']" position="replace"/>
            <xpath expr="//br[@t-if='doc.x_incoterm_custom_id and doc.incoterm_location']" position="replace"/>

            <!-- 4. Remove the "Shipping Policy:" line -->
            <xpath expr="//br[@t-if='doc.picking_policy']" position="replace"/>
            <xpath expr="//span[@t-if='doc.picking_policy']" position="replace"/>

            <!-- 5. Remove the "Shipping Method:" line -->
            <xpath expr="//br[@t-if='doc.shipping_method']" position="replace"/>
            <xpath expr="//span[@t-if='doc.shipping_method']" position="replace"/>

            <!-- 6. Remove "Incoterm Location" everywhere: the Studio "Incoterm Location:"
                 line, and the location under the code in the standard sale_stock
                 Incoterm block (keeps just the incoterm code, e.g. FOB, in the info row). -->
            <xpath expr="//span[@t-if='doc.incoterm_location']" position="replace"/>
            <xpath expr="//div[@t-if='doc.incoterm_location']/span[@t-field='doc.incoterm_location']" position="replace"/>
            <xpath expr="//div[@t-if='doc.incoterm_location']/br" position="replace"/>

        </field>
    </record>

</odoo>
